# scanner.py - Versão reajustada com melhorias integradas

import subprocess
import re
import json
import os
import socket
from datetime import datetime

from core.logger import info
from core.host_local import obter_host_local
from dotenv import load_dotenv
from mac_vendor_lookup import MacLookup

# Importações das novas melhorias
from core.classifier import classificar_dispositivo
from core.risk_scorer import calcular_risco_avancado, classificar_severidade, gerar_recomendacoes
from core.persistence import init_database, salvar_scan, carregar_historico, obter_evolucao_risco

from core.integrations.ddwrt import coletar_arp_ddwrt
from core.graph_generator import gerar_graficos

from core.utils import (
    obter_mac_por_ip,
    fabricante_por_mac,
    escanear_detalhado,
    detectar_rede,
    obter_nome_wifi,
    obter_gateway
)

# Coloque isso APÓS os outros imports, mas ANTES do resto do código
from core.security_rules import deve_escanear_portas, definir_timeout_scan
from core.threading_scan import scan_ports_parallel

# =========================
# Cache de portas (evita re-escanear o mesmo IP)
# =========================
PORTS_CACHE = {}

# =========================
# Configuração central
# =========================
CONFIG_PATH = "config.json"
historico_arquivo = "storage/historico_dispositivos.json"

if os.path.exists(CONFIG_PATH):
    with open(CONFIG_PATH, "r") as f:
        CONFIG = json.load(f)
else:
    CONFIG = {}

AMBIENTE = CONFIG.get("ambiente", "Casa")
gateway = CONFIG.get("gateway_ip") or obter_gateway()

# Inicializar banco de dados SQLite
init_database()

# Detectar host local
host_local = obter_host_local()
print("[INFO] Host local identificado")

# =========================
# Detectar rede
# =========================
rede = detectar_rede()
nome_wifi = obter_nome_wifi()
gateway = gateway
agora = datetime.now().isoformat()

print("Rede detectada:", rede)
print("Wi-Fi:", nome_wifi)
print("Gateway:", gateway)

# =========================
# Função para scan de portas
# =========================
def scan_ports(ip, ports=None):
    """Escaneia portas comuns no dispositivo"""
    if ports is None:
        ports = [22, 23, 80, 443, 445, 3389, 5900, 8080, 554, 1900]
    
    open_ports = []
    for port in ports:
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(0.3)
            result = sock.connect_ex((ip, port))
            if result == 0:
                open_ports.append(port)
            sock.close()
        except:
            pass
    return open_ports

# =========================
# NOVA Função de scan de portas OTIMIZADA (USA PARALELISMO)
# =========================
def scan_ports_optimized(ip, dispositivo_tipo="desconhecido", dispositivo_risco=0):
    """Versão OTIMIZADA - usa threads e cache"""
    
    # 1. Verificar cache (já escaneou esse IP antes?)
    if ip in PORTS_CACHE:
        return PORTS_CACHE[ip]
    
    # 2. Verificar se DEVE escanear este dispositivo
    deve_escanear = deve_escanear_portas({
        'ip': ip, 
        'tipo': dispositivo_tipo,
        'risco': dispositivo_risco
    })
    
    if not deve_escanear:
        PORTS_CACHE[ip] = []
        return []
    
    # 3. Definir timeout baseado no tipo
    timeout = definir_timeout_scan(dispositivo_tipo)
    
    # 4. Escanear portas em PARALELO (mais rápido!)
    print(f"[INFO] Escaneando portas de {ip} (modo paralelo)...")
    open_ports = scan_ports_parallel(ip, timeout=timeout)
    
    # 5. Salvar no cache
    PORTS_CACHE[ip] = open_ports
    
    return open_ports

# =========================
# Carregar histórico para análise comportamental
# =========================
historical_scans = carregar_historico(limit=50)
all_historical_devices = []
for scan in historical_scans:
    all_historical_devices.extend(scan.get('devices', []))

print(f"[INFO] Carregados {len(historical_scans)} scans históricos para análise")

# =========================
# Executar Nmap
# =========================
print("[INFO] Executando scan Nmap...")
resultado = subprocess.check_output(
    ["sudo", "nmap", "-sn", "-n", "-PR", rede]
).decode()

linhas = resultado.split("\n")
dispositivos = []

# Coleta dinâmica via gateway
try:
    dispositivos_ddwrt = coletar_arp_ddwrt(gateway)
    if not dispositivos_ddwrt:
        raise Exception("Sem resposta SSH útil")
except Exception:
    print("[INFO] Gateway sem acesso SSH — usando fallback Nmap padrão.")
    dispositivos_ddwrt = []

# =========================
# Parsing inicial do Nmap
# =========================
for linha in linhas:
    if "Nmap scan report for" in linha:
        nome = "desconhecido"
        ip = None

        match = re.search(r"for (.+) \((\d+\.\d+\.\d+\.\d+)\)", linha)
        if match:
            nome = match.group(1)
            ip = match.group(2)
        else:
            match = re.search(r"for (\d+\.\d+\.\d+\.\d+)", linha)
            if match:
                ip = match.group(1)

        if ip:
            dispositivos.append({
                "ip": ip,
                "nome": nome,
                "mac": "desconhecido",
                "fabricante": "desconhecido",
                "open_ports": []
            })

    elif "MAC Address" in linha:
        match = re.search(r"MAC Address: ([\w:]+) \((.+)\)", linha)
        if match and dispositivos:
            dispositivos[-1]["mac"] = match.group(1).lower()
            dispositivos[-1]["fabricante"] = match.group(2)

# =========================
# Mesclar DD-WRT + Nmap
# =========================
for dd in dispositivos_ddwrt:
    if not any(
        d["ip"] == dd["ip"] or (
            d["mac"] != "desconhecido" and d["mac"] == dd["mac"]
        )
        for d in dispositivos
    ):
        dispositivos.append({
            "ip": dd["ip"],
            "nome": "desconhecido",
            "mac": dd["mac"],
            "fabricante": fabricante_por_mac(dd["mac"]),
            "open_ports": []
        })

# =========================
# Carregar histórico JSON (legado)
# =========================
if os.path.exists(historico_arquivo):
    with open(historico_arquivo, "r") as f:
        historico_legado = json.load(f)
else:
    historico_legado = {}

# =========================
# Processamento central com novas melhorias
# =========================
novos_dispositivos = []
dispositivos_processados = []

for d in dispositivos:
    # Corrigir MAC se necessário
    if d["mac"] == "desconhecido":
        d["mac"] = obter_mac_por_ip(d["ip"])
    
    # Corrigir fabricante se necessário
    if d["fabricante"].lower() in ["unknown", "desconhecido"]:
        fabricante_mac = fabricante_por_mac(d["mac"])
        if fabricante_mac != "desconhecido":
            d["fabricante"] = fabricante_mac
    
    # Auto reconhecer host local
    ip = d.get("ip") or ""
    mac = d.get("mac") or ""
    hostname = (d.get("nome") or "").lower()
    
    if (ip == host_local.get("ip") or 
        mac == host_local.get("mac") or 
        hostname == host_local.get("hostname", "").lower()):
                d["tipo"] = "computador_conhecido"
        if d["mac"] == "desconhecido":
        d["mac"] = host_local.get("mac")
        d["fabricante"] = "local"
        d["open_ports"] = scan_ports_optimized(d["ip"], d.get("tipo", "desconhecido"), d.get("risco", 0))
                # Calcular risco avançado
        risk_score, risk_details = calcular_risco_avancado(d, all_historical_devices)
        d["risco"] = risk_score
        d["risk_details"] = risk_details
                severity, severity_class = classificar_severidade(risk_score)
        d["severity"] = severity
        d["recommendations"] = gerar_recomendacoes(risk_score, risk_details, d)
                print(f"[INFO] Host local classificado: {d['ip']} (Risco: {risk_score}/10)")
                dispositivos_processados.append(d)
        continue
    
    # Verificar se é dispositivo novo
    novo = (d["mac"] not in historico_legado and d["mac"] != "desconhecido")
    
    # Escanear portas do dispositivo
    print(f"[INFO] Escaneando portas de {d['ip']}...")
    d["open_ports"] = scan_ports(d["ip"])
    
    # Classificação melhorada com IP e portas
    tipo, nivel_confianca = classificar_dispositivo(
        hostname=d["nome"],
        vendor=d["fabricante"],
        ip=d["ip"],
        mac=d["mac"],
        open_ports=d["open_ports"]
    )
    
    d["tipo"] = tipo
    d["confianca"] = nivel_confianca
    
    # Se desconhecido, tentar scan detalhado
    if d["tipo"] == "desconhecido":
        tipo_detalhado = escanear_detalhado(d["ip"])
        if tipo_detalhado != "desconhecido":
            d["tipo"] = tipo_detalhado
    
    # Calcular risco avançado com histórico
    risk_score, risk_details = calcular_risco_avancado(d, all_historical_devices)
    d["risco"] = risk_score
    d["risk_details"] = risk_details
    
    severity, severity_class = classificar_severidade(risk_score)
    d["severity"] = severity
    d["recommendations"] = gerar_recomendacoes(risk_score, risk_details, d)
    
    # Registrar novo dispositivo
    if novo:
        novos_dispositivos.append({
            "ip": d["ip"],
            "nome": d["nome"],
            "mac": d["mac"],
            "fabricante": d["fabricante"],
            "tipo": d["tipo"],
            "risco": d["risco"],
            "risk_details": risk_details,
            "severity": severity,
            "timestamp": agora
        })
    
    # Atualizar histórico legado (JSON)
    if d["mac"] != "desconhecido":
        if d["mac"] not in historico_legado:
            historico_legado[d["mac"]] = {}
        
        historico_legado[d["mac"]].update({
            "tipo": d["tipo"],
            "primeira_vista": historico_legado[d["mac"]].get("primeira_vista", agora),
            "ultima_vista": agora,
            "frequencia": historico_legado[d["mac"]].get("frequencia", 0) + 1,
            "ultimo_risco": d["risco"],
            "ultima_severidade": severity
        })
    
    dispositivos_processados.append(d)

# =========================
# Métricas
# =========================
ativos = len(dispositivos_processados)
total_ips = 254
uso = (ativos / total_ips) * 100

desconhecidos = sum(1 for d in dispositivos_processados if d["tipo"] == "desconhecido")
mac_randomizados = sum(1 for d in dispositivos_processados if "privado" in d["fabricante"].lower())

risco_medio = round(sum(d["risco"] for d in dispositivos_processados) / ativos, 2) if ativos > 0 else 0

# Contar dispositivos por severidade
severidades = {"Baixo": 0, "Médio": 0, "Alto": 0, "Crítico": 0}
for d in dispositivos_processados:
    severidades[d.get("severity", "Baixo")] += 1

# =========================
# Recomendação
# =========================
if risco_medio <= 2:
    recomendacao = "✅ SEGURO - Rede com baixo risco"
elif risco_medio <= 4:
    recomendacao = "⚠️ ATENÇÃO - Risco moderado detectado"
elif risco_medio <= 6:
    recomendacao = "🔴 ALERTA - Risco elevado na rede"
else:
    recomendacao = "🚨 CRÍTICO - Ações imediatas necessárias"

# =========================
# Saída principal
# =========================
print("\n" + "="*60)
print("RESUMO DO SCAN")
print("="*60)
print(f"📊 IPs ativos: {ativos}")
print(f"📈 Uso da rede: {round(uso, 2)}%")
print(f"⚠️ Risco médio: {risco_medio}/10")
print(f"🎲 MACs randomizados: {mac_randomizados}")
print(f"❓ Dispositivos desconhecidos: {desconhecidos}")
print(f"💡 Recomendação: {recomendacao}")
print("\n📋 Severidade dos dispositivos:")
for sev, count in severidades.items():
    if count > 0:
        print(f"   {sev}: {count} dispositivo(s)")

# =========================
# Novos dispositivos
# =========================
if novos_dispositivos:
    print("\n🚨 NOVOS DISPOSITIVOS DETECTADOS:")
    for novo in novos_dispositivos:
        print(f"   {novo['ip']} → {novo['mac']} → {novo['fabricante']} → {novo['tipo']} → Risco {novo['risco']}/10 ({novo['severity']})")

# =========================
# Saída detalhada
# =========================
print("\n📱 DISPOSITIVOS DETECTADOS:")
print("-"*80)

tipos = {}
for d in dispositivos_processados:
    tipo = d["tipo"]
    tipos[tipo] = tipos.get(tipo, 0) + 1
    
    # Indicador visual de risco
    risk_icon = "🟢" if d["risco"] <= 2 else "🟡" if d["risco"] <= 5 else "🟠" if d["risco"] <= 7 else "🔴"
    
    # Mostrar portas se houver
    ports_info = f" [Portas: {', '.join(map(str, d['open_ports']))}]" if d.get('open_ports') else ""
    
    print(f"{risk_icon} {d['ip']:15} → {d['nome']:20} → {d['fabricante']:25} → {d['tipo']:20} → Risco {d['risco']}/10{d['severity']}{ports_info}")
    
    # Mostrar detalhes do risco se for alto
    if d["risco"] >= 6 and d.get('risk_details'):
        print(f"      ⚠️ Motivos: {', '.join(d['risk_details'][:3])}")

print("-"*80)

# =========================
# Resumo por tipo
# =========================
print("\n📊 RESULTADO POR TIPO DE DISPOSITIVO:")
for t, q in sorted(tipos.items(), key=lambda x: x[1], reverse=True):
    print(f"   {t}: {q}")

# =========================
# Salvar histórico legado (JSON)
# =========================
with open(historico_arquivo, "w") as f:
    json.dump(historico_legado, f, indent=4)

# =========================
# Preparar dados estruturados para SQLite
# =========================
dados = {
    "timestamp": agora,
    "ambiente": AMBIENTE,
    "wifi": nome_wifi,
    "subrede": rede,
    "gateway": gateway,
    "ips_ativos": ativos,
    "uso": round(uso, 2),
    "risco_medio": risco_medio,
    "desconhecidos": desconhecidos,
    "mac_randomizados": mac_randomizados,
    "novos_dispositivos": len(novos_dispositivos),
    "recomendacao": recomendacao,
    "severidades": severidades,
    "dispositivos": dispositivos_processados
}

# =========================
# Persistência SQLite REAL
# =========================
try:
    salvar_scan(dados)
    print("\n💾 Dados persistidos no SQLite com sucesso!")
except Exception as e:
    print(f"\n❌ Erro ao salvar no SQLite: {e}")

# =========================
# Salvar histórico temporal (JSON legado)
# =========================
historico_scans_arquivo = "storage/historico_scans.json"
if os.path.exists(historico_scans_arquivo):
    with open(historico_scans_arquivo, "r") as f:
        historico_scans = json.load(f)
else:
    historico_scans = []

historico_scans.append({
    "data": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
    "total_dispositivos": len(dispositivos_processados),
    "risco_medio": risco_medio,
    "severidades": severidades
})

# Manter apenas últimos 30 scans
with open(historico_scans_arquivo, "w") as f:
    json.dump(historico_scans[-30:], f, indent=4)

# =========================
# Geração de gráficos
# =========================
try:
    gerar_graficos(dados)
    print("📊 Gráficos gerados em reports/graficos/")
except Exception as e:
    print(f"❌ Erro ao gerar gráficos: {e}")

# =========================
# Geração do PDF (opcional)
# =========================
if CONFIG.get("gerar_pdf", False):
    try:
        from reports.pdf_report import gerar_pdf
        
        # Normalização dos dispositivos para o PDF
        dispositivos_pdf = []
        for d in dados["dispositivos"]:
            dispositivos_pdf.append({
                "ip": d.get("ip", "-"),
                "hostname": d.get("nome", d.get("hostname", "-")),
                "mac": d.get("mac", "-"),
                "vendor": d.get("fabricante", d.get("vendor", "Desconhecido")),
                "tipo": d.get("tipo", "desconhecido"),
                "risco": d.get("risco", 3),
                "severity": d.get("severity", "Médio"),
                "open_ports": d.get("open_ports", [])
            })
        
        caminho_pdf = gerar_pdf(dispositivos_pdf, historico_scans)
        print(f"📄 Relatório PDF gerado: {caminho_pdf}")
    except Exception as e:
        print(f"❌ Erro ao gerar PDF: {e}")

# =========================
# Alertas de segurança
# =========================
print("\n" + "="*60)
print("🔒 ALERTAS DE SEGURANÇA")
print("="*60)

alertas_gerados = 0
for d in dispositivos_processados:
    if d["risco"] >= 7:
        alertas_gerados += 1
        print(f"🚨 ALTO RISCO: {d['ip']} - {d['tipo']} (Risco {d['risco']}/10)")
        for rec in d.get('recommendations', [])[:2]:
            print(f"   → {rec}")
    elif d["risco"] >= 5:
        alertas_gerados += 1
        print(f"⚠️ RISCO MÉDIO: {d['ip']} - {d['tipo']} (Risco {d['risco']}/10)")

if alertas_gerados == 0:
    print("✅ Nenhum alerta de segurança significativo detectado")

print("="*60)
print(f"✅ Scan concluído em {datetime.now().strftime('%H:%M:%S')}")
