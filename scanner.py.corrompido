# ============================================================
# FUNÇÃO DE LIMPEZA DE ARQUIVOS ANTIGOS
# ============================================================
def limpar_arquivos_antigos():
    """Limpa arquivos antigos automaticamente"""
    try:
        # Limpar PDFs com mais de 30 dias
        pdf_path = "reports"
        if os.path.exists(pdf_path):
            for f in os.listdir(pdf_path):
                if f.endswith('.pdf'):
                    file_path = os.path.join(pdf_path, f)
                    if os.path.getmtime(file_path) < (datetime.now() - timedelta(days=30)).timestamp():
                        os.remove(file_path)
                        print(f"[INFO] Removido PDF antigo: {f}")
        
        # Limpar CSVs com mais de 7 dias
        csv_path = "exports"
        if os.path.exists(csv_path):
            for f in os.listdir(csv_path):
                if f.endswith('.csv'):
                    file_path = os.path.join(csv_path, f)
                    if os.path.getmtime(file_path) < (datetime.now() - timedelta(days=7)).timestamp():
                        os.remove(file_path)
                        print(f"[INFO] Removido CSV antigo: {f}")
        
        # Limpar gráficos com mais de 30 dias
        graficos_path = "reports/graficos"
        if os.path.exists(graficos_path):
            for f in os.listdir(graficos_path):
                if f.endswith('.png'):
                    file_path = os.path.join(graficos_path, f)
                    if os.path.getmtime(file_path) < (datetime.now() - timedelta(days=30)).timestamp():
                        os.remove(file_path)
                        print(f"[INFO] Removido gráfico antigo: {f}")
        
        print("[INFO] Limpeza de arquivos antigos concluída")
    except Exception as e:
        print(f"[WARN] Erro na limpeza: {e}")

# Chamar limpeza ao iniciar (opcional - descomente se quiser)
