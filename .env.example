# InfraInsight Configuration
# Copy to .env and adjust values

# Network Configuration
INFRA_NETWORK=192.168.0.0/24
INFRA_SCAN_INTERVAL=3600
INFRA_SCAN_TIMEOUT=120
INFRA_SCAN_SERVICES=false
INFRA_SCAN_PORTS=
INFRA_SCAN_SNMP=false
# SNMPv2c read-only community. Required only when INFRA_SCAN_SNMP=true.
INFRA_SNMP_COMMUNITY=
INFRA_SNMP_PORT=161
INFRA_CVE_LOOKUP=false
INFRA_CVE_CACHE_TTL_HOURS=48
INFRA_CVE_MIN_CONFIDENCE=70
# Optional NVD API key; leave empty to use public rate limits.
INFRA_NVD_API_KEY=

# Database
INFRA_DB_PATH=storage/infrainsight.db

# Dashboard
# dev creates the admin/admin123 test account; use production outside development.
INFRA_ENV=dev
INFRA_DASHBOARD_HOST=0.0.0.0
INFRA_DASHBOARD_PORT=5000
# Generate and configure a stable random value for persistent sessions.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
INFRA_SECRET_KEY=
# Debug mode is enabled only when INFRA_ENV=dev.

# Telegram Bot
INFRA_TELEGRAM_TOKEN=your-telegram-bot-token
INFRA_TELEGRAM_ALLOWED_USERS=user_id1,user_id2

# Logging
INFRA_LOG_LEVEL=INFO
INFRA_LOG_FILE=storage/logs/infrainsight.log

# Security
INFRA_SESSION_TIMEOUT=3600
INFRA_MAX_SCANS_PER_DAY=50

# Export
INFRA_EXPORT_PATH=exports
INFRA_REPORT_PATH=reports

# Features
INFRA_ENABLE_TELEGRAM=true
INFRA_ENABLE_DASHBOARD=true
