# dashboard/app.py - Dashboard profissional do InfraInsight

from flask import Flask, render_template, jsonify
import sqlite3
import os
from datetime import datetime

app = Flask(__name__)

DB_PATH = os.path.join(os.path.dirname(__file__), '..', 'storage', 'infrainsight.db')

def get_db_connection():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn

def calcular_infra_score(scan_data):
    """Calcula o InfraScore baseado nos dados do scan"""
    score = 0
    motivos = []
    
    dispositivos = scan_data.get('dispositivos', [])
    
    # Processar dispositivos
    telnet_count = 0
    rtsp_count = 0
    gateway_sem_https = False
    
    for d in dispositivos:
        open_ports = d.get('open_ports', [])
        if isinstance(open_ports, str):
            try:
                import json
                open_ports = json.loads(open_ports)
            except:
                open_ports = []
        
        if 23 in open_ports:
            telnet_count += 1
        if 554 in open_ports:
            rtsp_count += 1
        if d.get('tipo') == 'roteador' and 443 not in open_ports:
            gateway_sem_https = True
    
    # Telnet aberto (+3)
    if telnet_count > 0:
        score += 3
        motivos.append(f"🔴 Telnet aberto em {telnet_count} dispositivo(s)")
    
    # RTSP exposto (+1)
    if rtsp_count > 0:
        score += 1
        motivos.append(f"🟡 RTSP exposto em {rtsp_count} dispositivo(s)")
    
    # Muitos desconhecidos (+2 se >30%)
    total = scan_data.get('ips_ativos', 1)
    desconhecidos = scan_data.get('desconhecidos', 0)
    if total > 0 and desconhecidos / total > 0.3:
        score += 2
        motivos.append(f"🟠 {desconhecidos}/{total} dispositivos desconhecidos ({desconhecidos/total*100:.0f}%)")
    
    # Gateway sem HTTPS (+2)
    if gateway_sem_https:
        score += 2
        motivos.append(f"🔵 Gateway sem HTTPS (interface admin insegura)")
    
    score = min(score, 10)
    
    if score <= 2:
        status = "✅ Saudável"
        cor = "success"
    elif score <= 5:
        status = "⚠️ Atenção"
        cor = "warning"
    else:
        status = "🔴 Risco Elevado"
        cor = "danger"
    
    return {"score": score, "status": status, "cor": cor, "motivos": motivos}

@app.route("/")
def index():
    """Página principal do dashboard"""
    conn = get_db_connection()
    
    total_scans = conn.execute("SELECT COUNT(*) as count FROM scans").fetchone()["count"]
    
    latest_scan = conn.execute("""
        SELECT id, timestamp, ambiente, ips_ativos, uso, risco_medio, 
               desconhecidos, mac_randomizados, recomendacao
        FROM scans
        ORDER BY id DESC
        LIMIT 1
    """).fetchone()
    
    if not latest_scan:
        latest_scan = {
            'id': 0,
            'timestamp': datetime.now().isoformat(),
            'ambiente': 'N/A',
            'ips_ativos': 0,
            'uso': 0,
            'risco_medio': 0,
            'desconhecidos': 0,
            'mac_randomizados': 0,
            'recomendacao': 'Nenhum scan realizado'
        }
    else:
        latest_scan = dict(latest_scan)
    
    devices = []
    tipos_count = {}
    
    if latest_scan['id'] > 0:
        try:
            devices = conn.execute("""
                SELECT ip, nome, mac, fabricante, tipo, risk_score, severity, open_ports
                FROM dispositivos
                WHERE scan_id = ?
                ORDER BY risk_score DESC
            """, (latest_scan['id'],)).fetchall()
            
            for d in devices:
                tipo = d['tipo']
                tipos_count[tipo] = tipos_count.get(tipo, 0) + 1
        except:
            devices = []
    
    # Calcular InfraScore
    scan_data = {
        'dispositivos': [dict(d) for d in devices],
        'ips_ativos': latest_scan.get('ips_ativos', 0),
        'desconhecidos': latest_scan.get('desconhecidos', 0)
    }
    infra_score = calcular_infra_score(scan_data)
    
    # Histórico recente
    recent_scans = conn.execute("""
        SELECT timestamp, ips_ativos, uso, risco_medio, desconhecidos, mac_randomizados
        FROM scans
        ORDER BY id DESC
        LIMIT 10
    """).fetchall()
    
    # Evolução
    evolucao = conn.execute("""
        SELECT timestamp, risco_medio, ips_ativos
        FROM scans
        ORDER BY id DESC
        LIMIT 10
    """).fetchall()
    
    conn.close()
    
    recent_scans_list = []
    for scan in recent_scans:
        recent_scans_list.append({
            'timestamp': scan['timestamp'],
            'ips_ativos': scan['ips_ativos'],
            'uso': scan['uso'],
            'risco_medio': scan['risco_medio'],
            'desconhecidos': scan['desconhecidos'],
            'mac_randomizados': scan['mac_randomizados']
        })
    
    evolucao_list = []
    for item in evolucao:
        evolucao_list.append({
            'timestamp': item['timestamp'],
            'risco_medio': item['risco_medio'],
            'ips_ativos': item['ips_ativos']
        })
    
    return render_template(
        "index.html",
        total_scans=total_scans,
        latest_scan=latest_scan,
        devices=devices,
        tipos_count=tipos_count,
        infra_score=infra_score,
        recent_scans=recent_scans_list,
        evolucao=evolucao_list,
        now=datetime.now()
    )

@app.route("/history")
def history():
    conn = get_db_connection()
    scans = conn.execute("""
        SELECT id, timestamp, ips_ativos, uso, risco_medio, 
               desconhecidos, mac_randomizados, recomendacao
        FROM scans
        ORDER BY id DESC
    """).fetchall()
    conn.close()
    return render_template("history.html", scans=scans)

if __name__ == "__main__":
    app.run(debug=True, host='0.0.0.0', port=5000)
