"""
InfraInsight — pdf_report.py
Gera relatório PDF completo com:
  - Capa com logo e branding
  - Marca d'água em todas as páginas
  - Tabela de dispositivos
  - Gráficos matplotlib embutidos (pizza, barras, evolução)
  - Rodapé com timestamp e número de página

Dependências: reportlab, matplotlib, Pillow
  pip install reportlab matplotlib Pillow
"""

import os
import io
from datetime import datetime
from reportlab.lib.pagesizes import A4
from reportlab.lib import colors
from reportlab.lib.units import cm
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
from reportlab.lib.enums import TA_CENTER, TA_LEFT, TA_RIGHT
from reportlab.platypus import (
    SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle,
    Image, PageBreak, HRFlowable
)
from reportlab.pdfgen import canvas as rl_canvas

# ── Tenta importar gerador de gráficos ──────────────────────────────────────
try:
    import sys
    sys.path.insert(
        0, os.path.dirname(
            os.path.dirname(
                os.path.abspath(__file__))))
    from reports.graph_generator import gerar_todos
    GRAFICOS_OK = True
except ImportError:
    GRAFICOS_OK = False

# ── Paleta de cores ──────────────────────────────────────────────────────────
AZUL_ESCURO = colors.HexColor('#0D1117')
AZUL_MEDIO = colors.HexColor('#161B22')
AZUL_BORDA = colors.HexColor('#30363D')
AZUL_PRIMARIO = colors.HexColor('#185FA5')
AZUL_CLARO = colors.HexColor('#378ADD')
VERDE = colors.HexColor('#1D9E75')
VERMELHO = colors.HexColor('#E24B4A')
AMARELO = colors.HexColor('#EF9F27')
TEXTO_CLARO = colors.HexColor('#E6EDF3')
TEXTO_MUTED = colors.HexColor('#8B949E')
BRANCO = colors.white

# ── Risco → cor ─────────────────────────────────────────────────────────────
RISCO_COR = {
    1: colors.HexColor('#1D9E75'),
    2: colors.HexColor('#378ADD'),
    3: colors.HexColor('#EF9F27'),
    4: colors.HexColor('#D85A30'),
    5: colors.HexColor('#E24B4A'),
}

PASTA_REPORTS = 'reports'
PASTA_ASSETS = 'assets'


# ════════════════════════════════════════════════════════════════════════════
# Canvas builder — cabeçalho, rodapé e marca d'água em TODAS as páginas
# ════════════════════════════════════════════════════════════════════════════
class InfraInsightCanvas(rl_canvas.Canvas):

    def __init__(self, filename, logo_path=None, timestamp='', **kwargs):
        super().__init__(filename, **kwargs)
        self._saved_page_states = []
        self._logo_path = logo_path
        self._timestamp = timestamp
        self._page_num = 0

    def showPage(self):
        self._saved_page_states.append(dict(self.__dict__))
        self._startPage()

    def save(self):
        num_pages = len(self._saved_page_states)

        for page_num, state in enumerate(self._saved_page_states, start=1):
            self.__dict__.update(state)

            self._desenhar_watermark()
            self._desenhar_header()
            self._desenhar_footer(page_num, num_pages)

            super().showPage()

        super().save()

    def _desenhar_watermark(self):
        """Marca d'água semi-transparente no centro da página."""
        logo = self._logo_path
        if not logo or not os.path.exists(logo):
            # Watermark textual como fallback
            self.saveState()
            self.setFillColor(colors.HexColor('#30363D'))
            self.setFillAlpha(0.06)
            self.setFont('Helvetica-Bold', 52)
            w, h = A4
            self.translate(w / 2, h / 2)
            self.rotate(35)
            self.drawCentredString(0, 0, 'INFRAINSIGHT')
            self.restoreState()
            return

        w, h = A4
        self.saveState()
        self.setFillAlpha(0.06)
        logo_w = 8 * cm
        logo_h = 8 * cm
        self.drawImage(
            logo,
            (w - logo_w) / 2,
            (h - logo_h) / 2,
            width=logo_w,
            height=logo_h,
            preserveAspectRatio=True,
            mask='auto',
        )
        self.restoreState()

    def _desenhar_header(self):
        """Barra de topo com nome do produto."""
        w, h = A4
        self.saveState()
        self.setFillColor(AZUL_MEDIO)
        self.rect(0, h - 1.1 * cm, w, 1.1 * cm, fill=1, stroke=0)
        # Linha divisória
        self.setStrokeColor(AZUL_PRIMARIO)
        self.setLineWidth(1.5)
        self.line(0, h - 1.1 * cm, w, h - 1.1 * cm)
        # Texto
        self.setFillColor(TEXTO_CLARO)
        self.setFont('Helvetica-Bold', 8)
        self.drawString(1 * cm, h - 0.75 * cm, 'ANTENA INFRAINSIGHT')
        self.setFillColor(TEXTO_MUTED)
        self.setFont('Helvetica', 7)
        self.drawRightString(
            w - 1 * cm,
            h - 0.75 * cm,
            'Visibilidade Inteligente Para Sua Rede')
        self.restoreState()

    def _desenhar_footer(self, num, total):
        """Rodapé com timestamp e paginação."""
        w, _ = A4
        self.saveState()
        self.setStrokeColor(AZUL_BORDA)
        self.setLineWidth(0.5)
        self.line(1 * cm, 1.1 * cm, w - 1 * cm, 1.1 * cm)
        self.setFillColor(TEXTO_MUTED)
        self.setFont('Helvetica', 7)
        self.drawString(1 * cm, 0.65 * cm, f'Gerado em: {self._timestamp}')
        self.drawCentredString(
            w / 2,
            0.65 * cm,
            'Relatório Confidencial — InfraInsight')
        self.drawRightString(w - 1 * cm, 0.65 * cm, f'Página {num} / {total}')
        self.restoreState()


# ════════════════════════════════════════════════════════════════════════════
# Estilos de parágrafo
# ════════════════════════════════════════════════════════════════════════════

def _estilos():
    base = getSampleStyleSheet()

    titulo_capa = ParagraphStyle('TituloCapa',
                                 fontName='Helvetica-Bold', fontSize=28,
                                 textColor=TEXTO_CLARO, alignment=TA_CENTER, spaceAfter=6)

    subtitulo_capa = ParagraphStyle('SubtituloCapa',
                                    fontName='Helvetica', fontSize=13,
                                    textColor=AZUL_CLARO, alignment=TA_CENTER, spaceAfter=4)

    secao = ParagraphStyle('Secao',
                           fontName='Helvetica-Bold', fontSize=13,
                           textColor=AZUL_CLARO, spaceBefore=16, spaceAfter=6,
                           borderPadding=(0, 0, 4, 0))

    corpo = ParagraphStyle('Corpo',
                           fontName='Helvetica', fontSize=9,
                           textColor=TEXTO_CLARO, leading=14, spaceAfter=4)

    legenda = ParagraphStyle('Legenda',
                             fontName='Helvetica', fontSize=8,
                             textColor=TEXTO_MUTED, alignment=TA_CENTER, spaceAfter=10)

    rodape_info = ParagraphStyle('RodapeInfo',
                                 fontName='Helvetica', fontSize=8,
                                 textColor=TEXTO_MUTED, alignment=TA_CENTER)

    return {
        'titulo_capa': titulo_capa,
        'subtitulo_capa': subtitulo_capa,
        'secao': secao,
        'corpo': corpo,
        'legenda': legenda,
        'rodape_info': rodape_info,
    }


# ════════════════════════════════════════════════════════════════════════════
# Blocos de conteúdo
# ════════════════════════════════════════════════════════════════════════════

def _capa(estilos, total_dispositivos, total_desconhecidos,
          risco_medio, timestamp_legivel):
    """Bloco de capa do relatório."""
    itens = []
    itens.append(Spacer(1, 3.5 * cm))

    itens.append(Paragraph('ANTENA INFRAINSIGHT', estilos['titulo_capa']))
    itens.append(
        Paragraph(
            'Relatório de Scan de Rede',
            estilos['subtitulo_capa']))
    itens.append(Spacer(1, 0.4 * cm))
    itens.append(HRFlowable(width='80%', thickness=1.5, color=AZUL_PRIMARIO,
                            hAlign='CENTER', spaceAfter=20))
    itens.append(Spacer(1, 0.6 * cm))

    # Cards de métricas na capa
    dados_metricas = [
        ['Dispositivos\nDetectados', 'Desconhecidos', 'Risco\nMédio'],
        [str(total_dispositivos),
         str(total_desconhecidos),
            f'{risco_medio:.1f}'],
    ]
    t = Table(dados_metricas, colWidths=[4.5 * cm, 4.5 * cm, 4.5 * cm],
              rowHeights=[0.7 * cm, 1.2 * cm])
    t.setStyle(TableStyle([
        ('BACKGROUND', (0, 0), (-1, 0), AZUL_MEDIO),
        ('BACKGROUND', (0, 1), (-1, 1), AZUL_ESCURO),
        ('TEXTCOLOR', (0, 0), (-1, 0), TEXTO_MUTED),
        ('TEXTCOLOR', (0, 1), (-1, 1), AZUL_CLARO),
        ('FONTNAME', (0, 0), (-1, 0), 'Helvetica'),
        ('FONTNAME', (0, 1), (-1, 1), 'Helvetica-Bold'),
        ('FONTSIZE', (0, 0), (-1, 0), 7),
        ('FONTSIZE', (0, 1), (-1, 1), 18),
        ('ALIGN', (0, 0), (-1, -1), 'CENTER'),
        ('VALIGN', (0, 0), (-1, -1), 'MIDDLE'),
        ('GRID', (0, 0), (-1, -1), 0.5, AZUL_BORDA),
        ('ROUNDEDCORNERS', [4]),
    ]))
    itens.append(t)
    itens.append(Spacer(1, 0.6 * cm))
    itens.append(
        Paragraph(
            f'Gerado em: {timestamp_legivel}',
            estilos['rodape_info']))
    itens.append(PageBreak())
    return itens


def _tabela_dispositivos(dispositivos, estilos):
    """Tabela completa de dispositivos com cores por nível de risco."""
    itens = []
    itens.append(Paragraph('📋 Inventário de Dispositivos', estilos['secao']))
    itens.append(Spacer(1, 0.2*cm))
    
    cabecalho = ['IP', 'Hostname', 'Fabricante', 'Tipo', 'Risco']
    dados = [cabecalho]

    for d in dispositivos:
        risco = d.get('risco', 3)
        # Nome do tipo em português
        tipo_nome = {
            'roteador': 'Roteador',
            'switch/rede': 'Switch',
            'infraestrutura': 'Infraestrutura',
            'computador_conhecido': 'Computador',
            'desconhecido': 'Desconhecido',
            'camera_ip': 'Câmera IP',
            'smarttv': 'Smart TV'
        }.get(d.get('tipo', 'desconhecido'), d.get('tipo', 'desconhecido').replace('_', ' ').title())
        
        dados.append([
            d.get('ip', '-'),
            (d.get('hostname', '-') or '-')[:18],
            (d.get('vendor', 'Desconhecido') or 'Desconhecido')[:20],
            tipo_nome[:18],
            str(risco),
        ])

    col_w = [3.0 * cm, 3.5 * cm, 3.5 * cm, 3.5 * cm, 1.2 * cm]
    t = Table(dados, colWidths=col_w, repeatRows=1)

    style_cmds = [
        # Cabeçalho - fundo escuro, texto branco
        ('BACKGROUND', (0, 0), (-1, 0), AZUL_PRIMARIO),
        ('TEXTCOLOR', (0, 0), (-1, 0), BRANCO),
        ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
        ('FONTSIZE', (0, 0), (-1, 0), 9),
        # Linhas de dados
        ('FONTNAME', (0, 1), (-1, -1), 'Helvetica'),
        ('FONTSIZE', (0, 1), (-1, -1), 8),
        ('ALIGN', (0, 0), (-1, -1), 'CENTER'),
        ('VALIGN', (0, 0), (-1, -1), 'MIDDLE'),
        # Cores alternadas das linhas
        ('ROWBACKGROUNDS', (0, 1), (-1, -1), [AZUL_MEDIO, AZUL_ESCURO]),
        # Bordas
        ('GRID', (0, 0), (-1, -1), 0.5, AZUL_BORDA),
        ('TOPPADDING', (0, 0), (-1, -1), 6),
        ('BOTTOMPADDING', (0, 0), (-1, -1), 6),
        ('LEFTPADDING', (0, 0), (-1, -1), 4),
        ('RIGHTPADDING', (0, 0), (-1, -1), 4),
    ]

    # Colorir coluna de risco por nível
    for linha_idx, row in enumerate(dados[1:], start=1):
        try:
            nivel = int(row[4])
            cor = RISCO_COR.get(nivel, TEXTO_CLARO)
            style_cmds.append(('TEXTCOLOR', (4, linha_idx), (4, linha_idx), cor))
            style_cmds.append(('FONTNAME', (4, linha_idx), (4, linha_idx), 'Helvetica-Bold'))
        except (ValueError, IndexError):
            pass

    t.setStyle(TableStyle(style_cmds))
    itens.append(t)
    return itens

    # Colorir coluna de risco por nível
    for linha_idx, row in enumerate(dados[1:], start=1):
        try:
            nivel = int(row[5])
            cor = RISCO_COR.get(nivel, TEXTO_CLARO)
            style_cmds.append(
                ('TEXTCOLOR', (5, linha_idx), (5, linha_idx), cor))
            style_cmds.append(
                ('FONTNAME', (5, linha_idx), (5, linha_idx), 'Helvetica-Bold'))
        except (ValueError, IndexError):
            pass

    t.setStyle(TableStyle(style_cmds))
    itens.append(t)
    return itens


def _secao_graficos(caminhos_graficos, estilos):
    """Embute os gráficos PNG no PDF."""
    itens = []
    itens.append(PageBreak())
    itens.append(Paragraph('Análise Visual', estilos['secao']))
    itens.append(
        HRFlowable(
            width='100%',
            thickness=0.5,
            color=AZUL_BORDA,
            spaceAfter=12))

    largura_pg = A4[0] - 4 * cm  # margem total 2cm cada lado

    def _img_flowable(caminho, legenda_texto, largura=largura_pg):
        if not caminho or not os.path.exists(caminho):
            return []
        try:
            img = Image(caminho, width=largura, height=largura * 0.55,
                        kind='proportional')
            return [img, Paragraph(
                legenda_texto, estilos['legenda']), Spacer(1, 0.4 * cm)]
        except Exception:
            return []

    itens += _img_flowable(
        caminhos_graficos.get('pizza', ''),
        'Fig. 1 — Distribuição de dispositivos por tipo detectado na rede'
    )
    itens += _img_flowable(
        caminhos_graficos.get('barras', ''),
        'Fig. 2 — Quantidade de dispositivos por nível de risco (1=baixo, 5=crítico)'
    )

    evol = caminhos_graficos.get('evolucao', '')
    if evol and os.path.exists(evol):
        itens.append(PageBreak())
        itens += _img_flowable(
            evol,
            'Fig. 3 — Evolução temporal do número de dispositivos detectados por scan',
            largura=largura_pg
        )

    return itens


def _secao_resumo(dispositivos, estilos):
    """Seção de resumo estatístico."""
    itens = []
    itens.append(PageBreak())
    itens.append(Paragraph('Resumo Estatístico', estilos['secao']))
    itens.append(
        HRFlowable(
            width='100%',
            thickness=0.5,
            color=AZUL_BORDA,
            spaceAfter=8))

    # Contagem por tipo
    contagem_tipo = {}
    for d in dispositivos:
        t = d.get('tipo', 'desconhecido')
        contagem_tipo[t] = contagem_tipo.get(t, 0) + 1

    # Contagem por risco
    contagem_risco = {i: 0 for i in range(1, 6)}
    for d in dispositivos:
        r = min(5, max(1, int(d.get('risco', 3))))
        contagem_risco[r] += 1

    dados_tipo = [['Tipo', 'Quantidade']] + [
        [k.replace('_', ' ').title(), str(v)]
        for k, v in sorted(contagem_tipo.items(), key=lambda x: -x[1])
    ]
    dados_risco = [['Nível de Risco', 'Dispositivos']] + [
        [f'Risco {k}', str(v)] for k, v in contagem_risco.items() if v > 0
    ]

    def _mini_tabela(dados, cor_header):
        t = Table(dados, colWidths=[6 * cm, 3 * cm])
        t.setStyle(TableStyle([
            ('BACKGROUND', (0, 0), (-1, 0), cor_header),
            ('TEXTCOLOR', (0, 0), (-1, 0), BRANCO),
            ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
            ('FONTSIZE', (0, 0), (-1, -1), 8),
            ('TEXTCOLOR', (0, 1), (-1, -1), TEXTO_CLARO),
            ('FONTNAME', (0, 1), (-1, -1), 'Helvetica'),
            ('ROWBACKGROUNDS', (0, 1), (-1, -1), [AZUL_ESCURO, AZUL_MEDIO]),
            ('GRID', (0, 0), (-1, -1), 0.4, AZUL_BORDA),
            ('ALIGN', (0, 0), (-1, -1), 'CENTER'),
            ('VALIGN', (0, 0), (-1, -1), 'MIDDLE'),
            ('TOPPADDING', (0, 0), (-1, -1), 4),
            ('BOTTOMPADDING', (0, 0), (-1, -1), 4),
        ]))
        return t

    linha_tabelas = Table(
        [[_mini_tabela(dados_tipo, AZUL_PRIMARIO),
          _mini_tabela(dados_risco, colors.HexColor('#D85A30'))]],
        colWidths=[9.5 * cm, 9.5 * cm],
        hAlign='LEFT'
    )
    linha_tabelas.setStyle(TableStyle([
        ('ALIGN', (0, 0), (-1, -1), 'LEFT'),
        ('VALIGN', (0, 0), (-1, -1), 'TOP'),
        ('LEFTPADDING', (0, 0), (-1, -1), 0),
        ('RIGHTPADDING', (0, 0), (-1, -1), 16),
    ]))
    itens.append(linha_tabelas)
    return itens


# ════════════════════════════════════════════════════════════════════════════
# Função principal
# ════════════════════════════════════════════════════════════════════════════
def _secao_resumo_executivo(estilos, total_dispositivos, desconhecidos, risco_medio):
    """Seção de resumo executivo"""
    itens = []
    itens.append(Paragraph("📊 Resumo Executivo", estilos['secao']))
    itens.append(HRFlowable(width='100%', thickness=0.5, color=AZUL_BORDA, spaceAfter=8))
    
    if risco_medio <= 2:
        status = "✅ SAUDÁVEL"
        recomendacao = "Rede bem configurada. Continue monitorando."
    elif risco_medio <= 5:
        status = "⚠️ ATENÇÃO"
        recomendacao = "Alguns pontos precisam de atenção. Reveja as portas abertas."
    else:
        status = "🔴 CRÍTICO"
        recomendacao = "Ações imediatas necessárias! Verifique dispositivos suspeitos."
    
    dados = [
        ["Status Geral", status],
        ["Dispositivos", str(total_dispositivos)],
        ["Desconhecidos", str(desconhecidos)],
        ["Risco Médio", f"{risco_medio:.1f}/10"],
        ["Recomendação", recomendacao]
    ]
    
    t = Table(dados, colWidths=[5*cm, 9*cm])
    t.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (0,-1), AZUL_MEDIO),
        ('TEXTCOLOR', (0,0), (0,-1), TEXTO_CLARO),
        ('FONTNAME', (0,0), (0,-1), 'Helvetica-Bold'),
        ('FONTNAME', (1,0), (1,-1), 'Helvetica'),
        ('FONTSIZE', (0,0), (-1,-1), 9),
        ('GRID', (0,0), (-1,-1), 0.5, AZUL_BORDA),
    ]))
    itens.append(t)
    return itens

def _secao_portas(dispositivos, estilos):
    """Lista dispositivos com portas abertas"""
    itens = []
    dispositivos_com_portas = [d for d in dispositivos if d.get('open_ports')]
    
    if dispositivos_com_portas:
        itens.append(PageBreak())
        itens.append(Paragraph("🔓 Portas Abertas Detectadas", estilos['secao']))
        itens.append(HRFlowable(width='100%', thickness=0.5, color=AZUL_BORDA, spaceAfter=8))
        
        dados = [["IP", "Tipo", "Portas Abertas", "Serviços"]]
        for d in dispositivos_com_portas[:15]:
            portas = d.get('open_ports', [])
            servicos = []
            for p in portas:
                servico = {22: "SSH", 23: "Telnet", 80: "HTTP", 443: "HTTPS", 554: "RTSP"}.get(p, "")
                servicos.append(servico if servico else str(p))
            dados.append([
                d.get('ip', '-'),
                d.get('tipo', '-')[:15],
                ', '.join(map(str, portas[:5])),
                ', '.join(servicos[:5])
            ])
        
        t = Table(dados, colWidths=[3*cm, 4*cm, 3*cm, 4*cm])
        t.setStyle(TableStyle([
            ('BACKGROUND', (0,0), (-1,0), AZUL_PRIMARIO),
            ('TEXTCOLOR', (0,0), (-1,0), BRANCO),
            ('FONTNAME', (0,0), (-1,0), 'Helvetica-Bold'),
            ('FONTSIZE', (0,0), (-1,-1), 8),
            ('GRID', (0,0), (-1,-1), 0.5, AZUL_BORDA),
        ]))
        itens.append(t)
    return itens

def gerar_pdf(dispositivos: list, historico: list = None,
              nome_arquivo: str = None) -> str:
    """
    Gera o relatório PDF completo do InfraInsight.

    Parâmetros:
        dispositivos : lista de dicts com os dados do scan atual
        historico    : lista de dicts para o gráfico de evolução temporal
        nome_arquivo : caminho de saída (opcional; gerado automaticamente se None)

    Retorna:
        Caminho do arquivo PDF gerado.
    """
    os.makedirs(PASTA_REPORTS, exist_ok=True)

    ts = datetime.now()
    timestamp_fs = ts.strftime('%Y%m%d_%H%M%S')
    timestamp_leg = ts.strftime('%d/%m/%Y %H:%M:%S')

    if not nome_arquivo:
        nome_arquivo = os.path.join(PASTA_REPORTS,
                                    f'infrainsight_report_{timestamp_fs}.pdf')

    # ── Logo ─────────────────────────────────────────────────────────────
    logo_path = None
    for candidato in [
        os.path.join(PASTA_ASSETS, 'logo.png'),
        os.path.join(PASTA_ASSETS, 'logo_vertical.png'),
        os.path.join(PASTA_ASSETS, 'watermark.png'),
    ]:
        if os.path.exists(candidato):
            logo_path = candidato
            break

    # ── Gráficos ──────────────────────────────────────────────────────────
    caminhos_graficos = {}
    if GRAFICOS_OK:
        try:
            caminhos_graficos = gerar_todos(
                dispositivos,
                historico or [],
                timestamp=timestamp_fs
            )
        except Exception as e:
            print(f'[AVISO] Erro ao gerar gráficos: {e}')

    # ── Métricas para a capa ──────────────────────────────────────────────
    total = len(dispositivos)
    desconhecidos = sum(
        1 for d in dispositivos if d.get('tipo') == 'desconhecido')
    riscos = [
        d.get(
            'risco', 3) for d in dispositivos if isinstance(
            d.get('risco'), (int, float))]
    risco_medio = sum(riscos) / len(riscos) if riscos else 0.0

    # ── Estilos ───────────────────────────────────────────────────────────
    estilos = _estilos()

    # ── Documento ─────────────────────────────────────────────────────────
    doc = SimpleDocTemplate(
        nome_arquivo,
        pagesize=A4,
        leftMargin=1.8 * cm,
        rightMargin=1.8 * cm,
        topMargin=1.8 * cm,
        bottomMargin=1.8 * cm,
    )


    historia = []
    historia += _capa(estilos, total, desconhecidos, risco_medio, timestamp_leg)
    historia += _secao_resumo_executivo(estilos, total, desconhecidos, risco_medio)
    historia += Spacer(1, 0.2*cm)
    historia += _tabela_dispositivos(dispositivos, estilos)
    
    if caminhos_graficos:
        historia += _secao_graficos(caminhos_graficos, estilos)
    historia += _secao_resumo(dispositivos, estilos)


    # ── Build com canvas customizado ──────────────────────────────────────
    doc.build(
        historia,
        canvasmaker=lambda filename, **kw: InfraInsightCanvas(
            filename, logo_path=logo_path, timestamp=timestamp_leg, **kw
        )
    )

    return nome_arquivo


