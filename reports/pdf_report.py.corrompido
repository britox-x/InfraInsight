def _secao_resumo_executivo(estilos, total_dispositivos, desconhecidos, risco_medio):
    """Seção de resumo executivo"""
    itens = []
    itens.append(Paragraph("📊 Resumo Executivo", estilos['secao']))
    itens.append(HRFlowable(width='100%', thickness=0.5, color=AZUL_BORDA, spaceAfter=8))
    
    # Avaliação da rede
    if risco_medio <= 2:
        status = "✅ SAUDÁVEL"
        cor = VERDE
        recomendacao = "Rede bem configurada. Continue monitorando."
    elif risco_medio <= 5:
        status = "⚠️ ATENÇÃO"
        cor = AMARELO
        recomendacao = "Alguns pontos precisam de atenção. Reveja as portas abertas."
    else:
        status = "🔴 CRÍTICO"
        cor = VERMELHO
        recomendacao = "Ações imediatas necessárias! Verifique dispositivos suspeitos."
    
    dados = [
        ["Status Geral", status],
        ["Dispositivos", str(total_dispositivos)],
        ["Desconhecidos", str(desconhecidos)],
        ["Risco Médio", f"{risco_medio:.1f}/10"],
        ["Recomendação", recomendacao]
    ]
    
    t = Table(dados, colWidths=[5*cm, 9*cm])
    t.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (0,-1), AZUL_MEDIO),
        ('TEXTCOLOR', (0,0), (0,-1), TEXTO_CLARO),
        ('TEXTCOLOR', (1,0), (1,-1), TEXTO_CLARO),
        ('FONTNAME', (0,0), (0,-1), 'Helvetica-Bold'),
        ('FONTNAME', (1,0), (1,-1), 'Helvetica'),
        ('FONTSIZE', (0,0), (-1,-1), 9),
        ('ALIGN', (0,0), (-1,-1), 'LEFT'),
        ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
        ('GRID', (0,0), (-1,-1), 0.5, AZUL_BORDA),
    ]))
    itens.append(t)
    return itens

def _secao_portas(dispositivos, estilos):
    """Lista dispositivos com portas abertas"""
    itens = []
    # Filtrar dispositivos com portas abertas
    dispositivos_com_portas = [d for d in dispositivos if d.get('open_ports')]
    
    if dispositivos_com_portas:
        itens.append(PageBreak())
        itens.append(Paragraph("🔓 Portas Abertas Detectadas", estilos['secao']))
        itens.append(HRFlowable(width='100%', thickness=0.5, color=AZUL_BORDA, spaceAfter=8))
        
        dados = [["IP", "Tipo", "Portas Abertas", "Serviços"]]
        for d in dispositivos_com_portas[:15]:
            portas = d.get('open_ports', [])
            servicos = []
            for p in portas:
                servico = {22: "SSH", 23: "Telnet", 80: "HTTP", 443: "HTTPS", 554: "RTSP"}.get(p, "")
                servicos.append(servico if servico else str(p))
            dados.append([
                d.get('ip', '-'),
                d.get('tipo', '-')[:15],
                ', '.join(map(str, portas[:5])),
                ', '.join(servicos[:5])
            ])
        
        t = Table(dados, colWidths=[3*cm, 4*cm, 3*cm, 4*cm])
        t.setStyle(TableStyle([
            ('BACKGROUND', (0,0), (-1,0), AZUL_PRIMARIO),
            ('TEXTCOLOR', (0,0), (-1,0), BRANCO),
            ('FONTNAME', (0,0), (-1,0), 'Helvetica-Bold'),
            ('FONTSIZE', (0,0), (-1,-1), 8),
            ('GRID', (0,0), (-1,-1), 0.5, AZUL_BORDA),
        ]))
        itens.append(t)
    return itens
